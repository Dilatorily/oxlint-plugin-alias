{
  "name": "@dilatorily/oxlint-plugin-alias",
  "version": "1.0.0",
  "description": "An Oxlint plugin that autofixes import aliases",
  "keywords": [
    "alias",
    "aliases",
    "eslint",
    "imports",
    "oxlint",
    "plugin"
  ],
  "homepage": "https://github.com/Dilatorily/oxlint-plugin-alias#readme",
  "bugs": {
    "url": "https://github.com/Dilatorily/oxlint-plugin-alias/issues"
  },
  "license": "MIT",
  "author": "Huy Dang Lê-Ngô",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dilatorily/oxlint-plugin-alias.git"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "types": "lib/index.d.ts",
  "imports": {
    "#dilatorily/oxlint-plugin-alias/*": "./src/*.ts"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "commit": "lint-staged",
    "format": "oxfmt",
    "lint": "oxlint",
    "prepare": "husky",
    "test": "vitest"
  },
  "dependencies": {
    "@oxlint/plugins": "1.72.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.4",
    "@tsconfig/node-lts": "24.0.0",
    "@tsconfig/node-ts": "23.6.4",
    "@types/node": "26.1.0",
    "eslint-plugin-eslint-plugin": "7.4.1",
    "eslint-plugin-perfectionist": "5.9.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-vitest-rule-tester": "3.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "oxlint-tsgolint": "0.24.0",
    "publint": "0.3.21",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
